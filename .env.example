# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://buildathon:buildathon@localhost:5432/admissions

# Gemini (Google AI Studio key). Pick a current Flash-class model from the Gemini docs.
LLM_API_KEY=
LLM_MODEL=

# Use the real modules (stubs only for isolated tests)
USE_REAL_INTEL=1
USE_REAL_CRM=1
USE_REAL_SCHEDULING=1

# Auth
JWT_SECRET=change-me
