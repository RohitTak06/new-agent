# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://buildathon:buildathon@localhost:5432/admissions

# Gemini (Google AI Studio key). The fallback is optional: if the main model is overloaded or slow,
# the agent tries the other one. Load varies by model and by hour.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.6-flash

# Use the real modules (stubs only for isolated tests)
USE_REAL_INTEL=1
USE_REAL_CRM=1
USE_REAL_SCHEDULING=1

# Auth: the app refuses to start logins with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Demo only: lets an admin make calendar calls fail (POST /scheduling/faults).
# scripts/demo.py turns this on for the API it starts.
ENABLE_FAULT_INJECTION=0

# Limits on failed logins and on chat messages. Leave on.
RATE_LIMITS_ENABLED=1
